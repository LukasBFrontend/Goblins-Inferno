:root {
    --horizontal-text-margin: 2.5;
    -unity-font-definition: resource("Fonts/skeleboom");
    color: rgb(255, 255, 255);
}

Label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.upgradeImage {
    aspect-ratio: 1;
    height: 100%;
}

.rightContainer {
    margin-left: 12px;
}

.metaContainer {
    flex-direction: row;
    flex-grow: 0;
    margin-bottom: 6px;
}

.upgradeTextContainer {
    -unity-text-align: upper-left;
    flex-grow: 1;
}

.upgradeTitleLabel {
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: upper-left;
    margin-left: -2px;
}

.upgradeLvlTextContainer {
    flex-direction: row;
    justify-content: flex-end;
    -unity-text-align: upper-right;
    flex-grow: 1;
}

.upgradeLvlLabel {
    margin-right: 4px;
}

.upgradeLvlValue {
}

.textContainer {
    flex-grow: 1;
    font-size: 13px;
}

.upgradeDescriptionTextContainer {
    flex-direction: row;
    letter-spacing: -3px;
}

.emphasizedText {
    -unity-font-style: bold;
    color: rgb(255, 224, 0);
}

.upgradeButton {
    margin-bottom: 30px;
    color: rgba(255, 255, 255, 0.902);
    -unity-font-definition: resource("Fonts/skeleboom");
    letter-spacing: 7px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
    aspect-ratio: 4;
    height: 100px;
    flex-direction: row;
    padding-top: 14px;
    padding-right: 28px;
    padding-bottom: 14px;
    padding-left: 28px;
}

.upgradeButton:hover {
    color: rgb(255, 255, 255);
    scale: 1.05 1.05;
}

.upgradeButton:hover > .upgradeButtonBackground {
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(63, 63, 63, 0.961);
    background-image: resource("Asset Packs/Fantasy UI Borders/Default/Panel/panel-005#panel-005");
}

.upgradeButton:focus {
    color: rgb(255, 255, 255);
}

.upgradeButton:hover > .upgradeButtonBackground {
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(63, 63, 63, 0.961);
    background-image: resource("Asset Packs/Fantasy UI Borders/Default/Panel/panel-005#panel-005");
}

.upgradeButtonBackground {
    background-image: resource("Asset Packs/Fantasy UI Borders/Default/Transparent border/panel-transparent-border-005#panel-transparent-border-005");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 1.25px;
    background-color: rgb(0, 0, 0);
}

.upgradeBackgroundStat {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    -unity-background-image-tint-color: rgba(63, 130, 81, 0.902);
}

.upgradeBackgroundWeaponUnlock {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    -unity-background-image-tint-color: rgba(63, 59, 80, 0.902);
}
