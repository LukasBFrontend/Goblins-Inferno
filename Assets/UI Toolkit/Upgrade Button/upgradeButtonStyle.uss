:root {
    --horizontal-text-margin: 2.5;
}



Label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.upgradeButton {
    width: auto;
    height: 80px;
    aspect-ratio: 5;
    flex-direction: row;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.upgradeImage {
    aspect-ratio: 1;
    height: 100%;
}

.upgradeTextContainer {
    -unity-text-align: upper-left;
    margin-top: 0;
    margin-right: 16px;
    margin-bottom: 0;
    margin-left: 16px;
}

.upgradeTitleLabel {
    -unity-font-style: bold;
    font-size: 20px;
}

.upgradeLvlTextContainer {
    flex-direction: row;
    justify-content: flex-end;
    -unity-text-align: upper-right;
}

.upgradeLvlLabel {
    margin-right: 4px;
}

.upgradeLvlValue {
}

.upgradeDescriptionTextContainer {
    flex-direction: row;
}

.emphasizedText {
    -unity-font-style: bold;
    color: rgb(53, 53, 53);
}
