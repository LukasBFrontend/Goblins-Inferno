:root {
    -unity-font-definition: resource("Fonts/skeleboom");
    font-size: 18px;
}

Label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.runtime-tooltip {
    background-color: rgba(255, 255, 255, 0.812);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border-left-color: rgb(213, 175, 12);
    border-right-color: rgb(213, 175, 12);
    border-top-color: rgb(213, 175, 12);
    border-bottom-color: rgb(213, 175, 12);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.runtime-tooltip__label {
}

.menu-button {
    margin-bottom: 30px;
    width: 375px;
    color: rgba(255, 255, 255, 0.902);
    font-size: 26px;
    -unity-font-definition: resource("Fonts/skeleboom");
    letter-spacing: 7px;
    border-top-width: 2.5px;
    border-right-width: 2.5px;
    border-bottom-width: 2.5px;
    border-left-width: 2.5px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
    aspect-ratio: 4;
    overflow: hidden;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.menu-button-background {
    background-image: resource("Fantasy UI Borders/Default/Transparent center/panel-transparent-center-005#panel-transparent-center-005");
    background-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-background-image-tint-color: rgba(63, 63, 63, 0.902);
    -unity-slice-scale: 1.5px;
    -unity-slice-type: tiled;
    overflow: hidden;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
}

.menu-button-label {
    height: 100%;
}

.menu-button:hover {
    color: rgb(255, 255, 255);
    scale: 1.05 1.05;
}

.menu-button:hover .menu-button-background {
    background-image: resource("Fantasy UI Borders/Default/Transparent border/panel-transparent-border-005#panel-transparent-border-005");
    -unity-background-image-tint-color: rgba(63, 63, 63, 0.961);
    background-color: rgb(255, 255, 255);
}

.menu-button:focus {
    color: rgb(255, 255, 255);
}

.menu-button:focus .menu-button-background {
    background-image: resource("Fantasy UI Borders/Default/Transparent border/panel-transparent-border-005#panel-transparent-border-005");
    -unity-background-image-tint-color: rgba(63, 63, 63, 0.961);
    background-color: rgb(255, 255, 255);
}

.unity-foldout__text {
    transition-duration: 0.25s;
    transition-property: color;
}

.unity-foldout__input:focus .unity-foldout__text {
    color: rgb(28, 28, 28);
}

.unity-foldout__input:hover .unity-foldout__text {
    color: rgb(222, 222, 222);
}

.unity-foldout__checkmark {
    -unity-background-image-tint-color: rgb(0, 0, 0);
    transition-duration: 0.25s;
}

.unity-foldout__input:hover .unity-foldout__checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-list-view__item {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-list-view__item:hover {
    background-color: rgba(61, 61, 61, 0.588);
}

.unity-list-view__item:hover .character-stat-row-title {
    color: rgba(213, 175, 12, 0.863);
}

.unity-list-view__item .character-stat-row-title:hover {
    color: rgb(213, 175, 12);
}

.unity-progress-bar {
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    height: 26px;
}

.unity-progress-bar__container {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.196);
    border-right-color: rgba(0, 0, 0, 0.196);
    border-top-color: rgba(0, 0, 0, 0.196);
    border-bottom-color: rgba(0, 0, 0, 0.196);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    height: 100%;
    max-height: initial;
    max-width: initial;
}

.unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.392);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    height: 100%;
}

.unity-progress-bar__progress {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    height: 100%;
}

.unity-progress-bar__title {
    font-size: 20px;
}

.highscoreLabel {
    font-size: 32px;
    color: rgb(213, 213, 213);
}

.highscoreText {
    color: rgb(255, 255, 255);
    margin-left: 6px;
}

#HUDContainer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

#TopContainer {
    flex-direction: row;
    justify-content: space-between;
}

#SideContainer {
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    position: absolute;
    left: 0;
    bottom: 0;
    flex-direction: column-reverse;
}

#BottomContainer {
    justify-content: flex-end;
    align-items: flex-end;
    flex-direction: row;
    margin-bottom: 12px;
    position: absolute;
    bottom: 0;
    right: 0;
}

.infoContainer {
    color: rgb(255, 255, 255);
    height: 100%;
    -unity-text-align: middle-right;
    flex-grow: 0;
    flex-direction: column;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.706);
    font-size: 20px;
}

.infoText {
    width: 100px;
    font-size: 24px;
}

.centerText {
    -unity-text-align: upper-center;
}

#HealthBar {
    width: 300px;
}

#HealthBar > #unity-progress-bar > .unity-progress-bar__background > .unity-progress-bar__progress {
    width: 300px;
    background-color: rgb(163, 50, 50);
}

#ExpBar > #unity-progress-bar {
}

#ExpBar > #unity-progress-bar > .unity-progress-bar__background {
}

#ExpBar > #unity-progress-bar > .unity-progress-bar__background > .unity-progress-bar__progress {
    background-color: rgb(61, 168, 215);
}

.overlayContainer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.357);
}

.submenuContainer {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
}

.upperContainer {
    height: 45%;
    justify-content: flex-end;
    align-items: center;
}

.lowerContainer {
    flex-grow: 1;
    justify-content: flex-start;
    align-items: center;
}

.title {
    font-size: 72.5px;
    color: rgb(0, 0, 0);
    -unity-text-align: upper-center;
    margin-bottom: 40px;
    -unity-font-definition: resource("Fonts/blackwood_castle/BLACC___");
    text-shadow: 2px 2px 0 rgb(255, 255, 255);
    letter-spacing: 2px;
    -unity-text-outline-width: 0.75px;
    -unity-text-outline-color: rgb(255, 255, 255);
}

.titleIcon {
    width: 150px;
    height: 150px;
    position: absolute;
}

.gameOverTextContainer {
    font-size: 30px;
    -unity-font-definition: resource("Fonts/blackwood_castle/BLACC___");
    align-items: center;
    position: absolute;
    top: 0;
    bottom: 5%;
    left: 0;
    right: 0;
    justify-content: center;
}

.gameOverTextContainer .menu-button {
    margin-bottom: 0;
    height: 64px;
    margin-top: 24px;
}

.gameOverTextContainer > .title {
    margin-bottom: 0;
}

.scoreBoardContainer {
    -unity-slice-scale: 2px;
    margin-top: 10px;
    margin-bottom: 40px;
    overflow: hidden;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    width: 700px;
}

.scoreBoardBackground {
    padding-top: 42px;
    padding-right: 42px;
    padding-bottom: 42px;
    padding-left: 42px;
    -unity-background-image-tint-color: rgb(151, 54, 54);
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 2px;
    background-image: resource("Fantasy UI Borders/Default/Border/panel-border-026#panel-border-026");
}

.gameOverStatContainer {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
    color: rgb(224, 224, 224);
    margin-left: 8px;
    margin-right: 8px;
}

.gameOverStatValue {
    color: rgb(255, 207, 1);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/RandomLetters");
    margin-left: 12px;
    margin-top: 4px;
}

.gameOverMessageText {
    filter: opacity(0.9);
    -unity-text-align: upper-left;
    -unity-font-style: normal;
    -unity-font-definition: resource("Fonts/skeleboom");
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    font-size: 30px;
    word-spacing: 20px;
    margin-top: 30px;
}
